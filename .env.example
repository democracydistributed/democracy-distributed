# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# Corteza Auth Client (System → Auth clients → "DD Member Login", handle dd-member-login)
CORTEZA_CLIENT_ID=
CORTEZA_CLIENT_SECRET=

# Corteza Auth Client (System → Auth clients → "DD Anonymous Submissions", handle
# dd-anon-submissions). client_credentials grant, impersonates Anonymous Integration
# User. Server-only — used by src/lib/corteza-write.ts to submit on behalf of
# visitors who aren't logged in. Never prefix with NEXT_PUBLIC_.
CORTEZA_ANON_CLIENT_ID=
CORTEZA_ANON_CLIENT_SECRET=

# Kill switch for gateway response caching (server-side proxy cache + SSR data cache).
# Unset or anything other than "true" = caching fully OFF, every request goes straight
# to Corteza. Flip to "true" only for a specific endpoint that's a proven, measured
# slowness problem — see the docs repo's build/caching.md before turning this on.
GATEWAY_CACHE_ENABLED=false
